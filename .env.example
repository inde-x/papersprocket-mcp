# PaperSprocket MCP server — configuration template.
#
# Copy to `.env` and set real values. This file contains NO secrets.
#
# REQUIRED: the PaperSprocket API key (secret/config state). Never passed as a
# tool argument by the caller; the server reads it from here / the environment.
# PAPERSPROCKET_API_KEY=psk_...

# OPTIONAL: override the API base URL. Defaults to the production PaperSprocket
# API (https://papersprocket.com/api). Fixed/config state — not arg-controlled.
# PAPERSPROCKET_BASE_URL=https://papersprocket.com/api

# OPTIONAL: directory where rendered PDFs are also written (best-effort) so
# filesystem-local MCP clients can read them directly. Default: ./output
# PAPERSPROCKET_MCP_OUTPUT_DIR=./output